generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MediaPurpose {
  PROFILE_AVATAR
  PROFILE_COVER
  CHURCH_LOGO
  CHURCH_COVER
  POST_PHOTO
  PROFILE_PHOTO
}

enum MediaStatus {
  UPLOADING
  READY
  RETIRED
}

model MediaAsset {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploaderId String
  requestKey String
  fingerprint String
  purpose MediaPurpose
  profileUserId String?
  churchId String?
  postId String?
  isCurrent Boolean @default(true)
  personalPhoto PersonalPhoto?
  postReferences PostPhotoReference[]
  status MediaStatus @default(UPLOADING)
  version Int @default(1)
  storagePrefix String @unique
  leaseUntil DateTime
  replacesId String?
  caption String @default("")
  alt String @default("")
  position Int @default(0)
  variants Json @default("{}")
  crop Json?
  uploader PlatformUser @relation("ImageUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  profileUser PlatformUser? @relation("ProfileImage", fields: [profileUserId], references: [id], onDelete: Restrict)
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  post PlatformPost? @relation(fields: [postId], references: [id], onDelete: Restrict)
  @@unique([uploaderId, requestKey])
  @@index([profileUserId, purpose, status])
  @@index([churchId, purpose, status])
  @@index([postId, status, position])
  @@index([status, leaseUntil])
}

// Every external write is registered before I/O. Successful attachment removes
// its entry; failed attempts and replaced/removed files remain for bounded cleanup.
model MediaGarbage {
  storagePrefix String @id
  dueAt DateTime
  @@index([dueAt])
}

enum PersonalPhotoAudience {
  ONLY_ME
  MEMBERS
  PUBLIC
  CHURCH
  SOURCE
}

// A library association never replaces the asset's original source boundary.
model PersonalPhoto {
  assetId String @id
  ownerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  audience PersonalPhotoAudience
  audienceChurchId String?
  hiddenAt DateTime?
  deletedAt DateTime?
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  audienceChurch Church? @relation(fields: [audienceChurchId], references: [id], onDelete: Restrict)
  @@index([ownerId, deletedAt, createdAt, assetId])
}

// Explicitly selected saved photos reuse their existing processed bytes.
model PostPhotoReference {
  postId String
  assetId String
  ownerId String
  position Int
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  @@id([postId, assetId])
  @@index([assetId])
}

enum WaitlistRole {
  BELIEVER
  CHURCH
  CREATOR
  BUSINESS
  BUILDER
}

enum AnalyticsEventType {
  PAGE_VIEW
  CTA_CLICK
  JOIN_SUBMIT
  JOIN_SUCCESS
}

model WaitlistSignup {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  role      WaitlistRole
  name      String
  email     String
  message   String?
  source    String?

  @@unique([email, role])
  @@index([createdAt])
  @@index([role])
  @@index([email])
}

model WaitlistEvent {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  eventType AnalyticsEventType
  path      String
  role      WaitlistRole?
  label     String?
  userAgent String?
  ipHash    String?
  referrer  String?

  @@index([createdAt])
  @@index([eventType])
  @@index([path])
}

enum PlatformRole {
  BELIEVER
  CHURCH
  CREATOR
  BUSINESS
  BUILDER
}

enum PlatformPostType {
  TESTIMONY
  PRAYER
  TEACHING
  UPDATE
  NEED
}

model PlatformUser {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  name         String
  username     String       @unique
  email        String       @unique
  passwordHash String?
  credentialVersion Int @default(0)
  emailVerifiedAt DateTime?
  suspendedAt DateTime?
  deactivatedAt DateTime?
  adultAcknowledgedAt DateTime?
  adultPolicyVersion String?
  portalVersion Int @default(0)
  role         PlatformRole @default(BELIEVER)
  bio          String?
  location     String?
  website      String?
  interests    String[]     @default([])
  uploadedImages MediaAsset[] @relation("ImageUploader")
  profileImages MediaAsset[] @relation("ProfileImage")
  personalPhotos PersonalPhoto[]
  postPhotoReferences PostPhotoReference[]
  presentation ProfilePresentation?
  socialPreferences SocialPreferences?
  socialRelations SocialRelationship[] @relation("SocialOwner")
  socialTargets SocialRelationship[] @relation("SocialTarget")
  socialOperations SocialOperation[]
  friendInvitation FriendInvitation?
  sentFriendAcceptances FriendAcceptance[] @relation("FriendInviter")
  receivedFriendAcceptances FriendAcceptance[] @relation("FriendRecipient")
  commentLikes CommentLike[]
  commentMentions CommentMention[]
  conversationPreferences ConversationPreference[]
  commentDrafts PrivateCommentDraft[]
  privatePostDrafts PrivatePostDraft[]
  savedPostCollections SavedPostCollection[]
  savedPostItems SavedPostItem[]
  postWorkspaceOperations PostWorkspaceOperation[]

  posts     PlatformPost[]
  postLikes PlatformPostLike[]
  comments  PlatformPostComment[]
  sessions  PlatformSession[]
  accountGrants PlatformAccountGrant[]
  emailChange PlatformEmailChange?
  googleIdentity PlatformGoogleIdentity?
  googleAttempts PlatformGoogleAttempt[]
  recentAuthentications PlatformRecentAuthentication[]
  connections ChurchConnection[]
  churchGrants ChurchCapabilityGrant[]
  issuedRoleGrants ChurchRoleGrant[]
  churchChartSaves ChurchChartSave[]
  operatorGrants PlatformOperatorGrant[]
  churchClaims ChurchClaim[]
  churchListings ChurchListingSubmission[]
  contactAssignments ChurchContactAssignment[]
  calendars PlatformCalendar[] @relation("CalendarOwner")
  createdCalendars PlatformCalendar[] @relation("CalendarCreator")
  eventResponses CalendarResponse[]
  pollBallots PostPollBallot[]
  volunteerSignups PostVolunteerSignup[]
  supportGrants SupportCapabilityGrant[]
  supportCases SupportCase[]
  supportMessages SupportMessage[]
  supportReads SupportRead[]
  supportOperations SupportOperation[]
  following PlatformFollow[]      @relation("following")
  followers PlatformFollow[]      @relation("followers")

  @@index([role])
  @@index([createdAt])
}

model ProfilePresentation {
  userId String @id
  version Int @default(1)
  palette String @default("sage")
  background String @default("plain")
  sectionOrder String @default("about-first")
  introduction String @default("")
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlatformGoogleIdentity {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  userId String @unique
  issuer String
  subject String
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  recentAuthentications PlatformRecentAuthentication[]
  @@unique([issuer, subject])
}

model PlatformGoogleAttempt {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  stateHash String @unique
  browserHash String
  nonceHash String
  returnTo String
  consumedAt DateTime?
  completedAt DateTime?
  linkUserId String?
  linkSessionId String?
  credentialVersion Int?
  reauthPurpose String?
  reactivationTokenHash String? @unique
  signupTokenHash String? @unique
  subject String?
  email String?
  emailAuthoritative Boolean @default(false)
  linkUser PlatformUser? @relation(fields: [linkUserId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@index([linkUserId])
}

model PlatformEmailChange {
  id String @id @default(cuid())
  userId String @unique
  tokenHash String @unique
  newEmail String
  credentialVersion Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model PlatformRecentAuthentication {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  tokenHash String @unique
  purpose String
  credentialVersion Int
  userId String
  sessionId String
  googleIdentityId String
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  session PlatformSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  googleIdentity PlatformGoogleIdentity @relation(fields: [googleIdentityId], references: [id], onDelete: Cascade)
  @@unique([sessionId, purpose])
  @@index([userId])
  @@index([googleIdentityId])
  @@index([expiresAt])
}

model PlatformSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  tokenHash String   @unique
  userId    String
  userAgent String?
  credentialVersion Int @default(0)

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  recentAuthentications PlatformRecentAuthentication[]

  @@index([userId])
  @@index([expiresAt])
}

enum AccountGrantPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

model PlatformAccountGrant {
  id String @id @default(cuid())
  userId String
  purpose AccountGrantPurpose
  tokenHash String @unique
  credentialVersion Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model PlatformAuthLimit {
  key String @id
  hits Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum ChurchConnectionState {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
  LEFT
  REMOVED
}

enum ChurchCapability {
  REVIEW_CONNECTIONS
  APPOINT_COORDINATORS
  MANAGE_CHURCH_PROFILE
  MANAGE_CHURCH_ACCESS
  MANAGE_STRUCTURE
  EDIT_CHURCH_CALENDAR
  PUBLISH_CHURCH_EVENTS
  PUBLISH_CHURCH_POSTS
  MODERATE_CHURCH_POSTS
  MANAGE_CHURCH_VOLUNTEERS
}

enum OperatorCapability {
  ESTABLISH_CHURCH
  REVIEW_CHURCH_LISTINGS
  REVIEW_CHURCH_CLAIMS
  MANAGE_CHURCH_ACCESS
  MANAGE_ACCOUNTS
  ASSIGN_RELATIONSHIP_OWNER
}

enum ChurchContactSlot {
  PRIMARY
  BACKUP
  RELATIONSHIP_OWNER
}

enum DirectoryAudience {
  ONLY_ME
  SAME_CHURCH
}

model Church {
  socialRelations SocialRelationship[]
  authoredComments PlatformPostComment[]
  id String @id @default(cuid())
  slug String @unique
  name String
  summary String
  version Int @default(1)
  managementVersion Int @default(0)
  structureVersion Int @default(0)
  communityListed Boolean @default(false)
  city String @default("")
  region String @default("")
  country String @default("")
  serviceArea String @default("")
  locationModel String @default("NO_BUILDING")
  website String @default("")
  publicEmail String @default("")
  publicPhone String @default("")
  meetingInfo String @default("")
  denomination String @default("")
  source String @default("")
  createdAt DateTime @default(now())
  connections ChurchConnection[]
  grants ChurchCapabilityGrant[]
  contacts ChurchContactAssignment[]
  events ChurchAuditEvent[]
  supportCases SupportCase[]
  claims ChurchClaim[]
  listings ChurchListingSubmission[]
  positions ChurchPosition[]
  roleTemplates ChurchRoleTemplate[]
  chartSaves ChurchChartSave[]
  calendars PlatformCalendar[]
  authoredPosts PlatformPost[] @relation("ChurchPostAuthor")
  sharedPosts PlatformPost[] @relation("ChurchPostAudience")
  calendarShares CalendarShare[]
  eventShares CalendarEventShare[]
  personalPhotoAudiences PersonalPhoto[]
  images MediaAsset[]
}

enum ChurchListingStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFORMATION
  PUBLISHED
  REJECTED
  WITHDRAWN
}

model ChurchListingSubmission {
  id String @id @default(cuid())
  ownerId String
  requestKey String
  kind String
  churchId String?
  baseVersion Int?
  data Json
  status ChurchListingStatus @default(DRAFT)
  version Int @default(1)
  reviewReason String @default("")
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  decisions ChurchListingDecision[]
  @@unique([ownerId, requestKey])
  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
  @@index([churchId])
}

model ChurchListingDecision {
  id String @id @default(cuid())
  submissionId String
  actorId String
  action String
  reason String
  version Int
  createdAt DateTime @default(now())
  submission ChurchListingSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  @@index([submissionId, createdAt])
}

model ChurchConnection {
  id String @id @default(cuid())
  userId String
  churchId String
  state ChurchConnectionState
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  preference ChurchDirectoryPreference?
  dependentGrants ChurchCapabilityGrant[]
  contacts ChurchContactAssignment[]
  supportShares SupportCoordinatorShare[]
  positionAssignments ChurchPositionAssignment[]
  calendarShares CalendarShare[]
  eventShares CalendarEventShare[]
  @@unique([userId, churchId])
  @@unique([id, churchId])
  @@index([churchId, state])
}

enum ChurchPositionPlacement {
  UNCONNECTED
  ROOT
  REPORTING
}

model ChurchPosition {
  id String @id @default(cuid())
  churchId String
  parentId String?
  placement ChurchPositionPlacement @default(UNCONNECTED)
  chartX Int?
  chartY Int?
  name String
  description String @default("")
  roleTemplateId String?
  roleTemplateVersion Int?
  roleRevision ChurchRoleRevision? @relation(fields: [roleTemplateId, churchId, roleTemplateVersion], references: [templateId, churchId, version], onDelete: Restrict, onUpdate: Restrict)
  requestKey String
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  parent ChurchPosition? @relation("ChurchPositionTree", fields: [parentId, churchId], references: [id, churchId], onDelete: Restrict, onUpdate: Restrict)
  children ChurchPosition[] @relation("ChurchPositionTree")
  assignments ChurchPositionAssignment[]
  @@unique([id, churchId])
  @@unique([churchId, requestKey])
  @@index([churchId, archivedAt])
}

model ChurchRoleTemplate {
  id String @id @default(cuid())
  churchId String
  normalizedName String
  version Int @default(1)
  requestKey String
  archivedAt DateTime?
  createdAt DateTime @default(now())
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  revisions ChurchRoleRevision[]
  @@unique([id, churchId])
  @@unique([churchId, requestKey])
  @@index([churchId, archivedAt])
}

model ChurchRoleRevision {
  templateId String
  churchId String
  version Int
  name String
  description String
  responsibilities String
  starterId String?
  presetKey String
  presetVersion Int
  recommendations ChurchCapability[]
  createdAt DateTime @default(now())
  template ChurchRoleTemplate @relation(fields: [templateId, churchId], references: [id, churchId], onDelete: Restrict, onUpdate: Restrict)
  positions ChurchPosition[]
  @@id([templateId, churchId, version])
}

model ChurchPositionAssignment {
  id String @id @default(cuid())
  churchId String
  positionId String
  connectionId String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  version Int @default(1)
  roleGrants ChurchRoleGrant[]
  saves ChurchAssignmentSave[]
  position ChurchPosition @relation(fields: [positionId, churchId], references: [id, churchId], onDelete: Restrict, onUpdate: Restrict)
  connection ChurchConnection @relation(fields: [connectionId, churchId], references: [id, churchId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([positionId, connectionId])
  @@unique([id, churchId, connectionId])
  @@index([connectionId, revokedAt])
}

enum CalendarVisibility {
  PRIVATE
  CHURCH
  PUBLIC
}

enum CalendarShareLevel {
  BUSY
  DETAILS
}

enum CalendarResponseState {
  GOING
  MAYBE
  DECLINED
}

model PlatformCalendar {
  id String @id @default(cuid())
  ownerId String?
  churchId String?
  creatorId String
  requestKey String
  name String
  timeZone String
  version Int @default(1)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner PlatformUser? @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  creator PlatformUser @relation("CalendarCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  events CalendarEvent[]
  shares CalendarShare[]
  audit CalendarAudit[]
  @@unique([creatorId, requestKey])
  @@index([ownerId, archivedAt])
  @@index([churchId, archivedAt])
}

model CalendarEvent {
  id String @id @default(cuid())
  calendarId String
  requestKey String
  title String
  description String @default("")
  location String @default("")
  onlineUrl String @default("")
  organizer String @default("")
  visibility CalendarVisibility @default(PRIVATE)
  allDay Boolean @default(false)
  timeZone String
  startLocal String
  endLocal String
  weeklyUntil String?
  version Int @default(1)
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  calendar PlatformCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  occurrences CalendarOccurrence[]
  shares CalendarEventShare[]
  @@unique([calendarId, requestKey])
  @@index([calendarId, canceledAt])
}

model CalendarOccurrence {
  id String @id @default(cuid())
  eventId String
  ordinal Int
  title String
  description String @default("")
  location String @default("")
  onlineUrl String @default("")
  organizer String @default("")
  allDay Boolean
  timeZone String
  startLocal String
  endLocal String
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  isException Boolean @default(false)
  canceledAt DateTime?
  version Int @default(1)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  responses CalendarResponse[]
  @@unique([eventId, ordinal])
  @@index([startAt, endAt])
  discussionPost PlatformPost?
}

model CalendarShare {
  id String @id @default(cuid())
  calendarId String
  churchId String
  connectionId String
  level CalendarShareLevel
  version Int @default(1)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  calendar PlatformCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  connection ChurchConnection @relation(fields: [connectionId, churchId], references: [id, churchId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([calendarId, churchId])
  @@index([connectionId, revokedAt])
}

model CalendarEventShare {
  id String @id @default(cuid())
  eventId String
  churchId String
  connectionId String
  level CalendarShareLevel
  version Int @default(1)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  connection ChurchConnection @relation(fields: [connectionId, churchId], references: [id, churchId], onDelete: Restrict, onUpdate: Restrict)
  @@unique([eventId, churchId])
  @@index([connectionId, revokedAt])
}

model CalendarResponse {
  id String @id @default(cuid())
  occurrenceId String
  userId String
  state CalendarResponseState
  version Int @default(1)
  updatedAt DateTime @updatedAt
  occurrence CalendarOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([occurrenceId, userId])
  @@index([userId, state])
}

model CalendarAudit {
  id String @id @default(cuid())
  calendarId String
  actorId String
  targetId String
  action String
  version Int
  createdAt DateTime @default(now())
  calendar PlatformCalendar @relation(fields: [calendarId], references: [id], onDelete: Restrict)
  @@index([calendarId, createdAt])
}

model ChurchDirectoryPreference {
  connectionId String @id
  listed Boolean @default(false)
  displayName String @default("")
  contactEmail String?
  phone String?
  emailAudience DirectoryAudience @default(ONLY_ME)
  phoneAudience DirectoryAudience @default(ONLY_ME)
  connection ChurchConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model ChurchCapabilityGrant {
  sourceClaimId String?
  sourceClaim ChurchClaim? @relation(fields: [sourceClaimId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  userId String
  churchId String
  capability ChurchCapability
  dependencyConnectionId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  dependency ChurchConnection? @relation(fields: [dependencyConnectionId], references: [id], onDelete: Restrict)
  @@unique([userId, churchId, capability])
}

model PlatformOperatorGrant {
  id String @id @default(cuid())
  userId String
  capability OperatorCapability
  revokedAt DateTime?
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, capability])
}

model ChurchContactAssignment {
  id String @id @default(cuid())
  churchId String
  userId String
  slot ChurchContactSlot
  connectionId String?
  contactEmail String?
  phone String?
  version Int @default(1)
  revokedAt DateTime?
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  connection ChurchConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  supportShares SupportCoordinatorShare[]
  @@unique([churchId, slot])
}

enum SupportCapability {
  RESPOND
  ASSIGN
  REDACT
}

enum SupportCategory {
  ACCOUNT_WEBSITE
  CHURCH_SETUP
  DIRECTORY_SHARING
  FEATURE_SUGGESTION
}

enum SupportStatus {
  RECEIVED
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
}

enum SupportFeatureDecision {
  RECEIVED
  UNDER_CONSIDERATION
  PLANNED
  DELIVERED
  DEFERRED
  DECLINED
}

model SupportCapabilityGrant {
  id String @id @default(cuid())
  userId String
  capability SupportCapability
  version Int @default(1)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignedCases SupportCase[]
  intakeSettings SupportIntakeSetting[]
  @@unique([userId, capability])
}

model SupportIntakeSetting {
  id String @id
  enabled Boolean @default(false)
  ownerGrantId String
  approvedNoticeVersion String?
  ownerGrant SupportCapabilityGrant @relation(fields: [ownerGrantId], references: [id], onDelete: Restrict)
}

model SupportCase {
  id String @id @default(cuid())
  requesterId String
  churchId String?
  category SupportCategory
  subject String
  description String
  ownerGrantId String?
  ownerGrantVersion Int?
  status SupportStatus @default(RECEIVED)
  version Int @default(1)
  resolution String?
  featureDecision SupportFeatureDecision?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requester PlatformUser @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  ownerGrant SupportCapabilityGrant? @relation(fields: [ownerGrantId], references: [id], onDelete: Restrict)
  coordinatorShare SupportCoordinatorShare?
  messages SupportMessage[]
  reads SupportRead[]
  operations SupportOperation[]
  audit SupportAuditEvent[]
  @@index([requesterId, updatedAt])
  @@index([ownerGrantId, updatedAt])
  @@index([status, updatedAt])
}

model SupportCoordinatorShare {
  caseId String @id
  appointmentId String
  appointmentVersion Int
  requesterConnectionId String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  appointment ChurchContactAssignment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  requesterConnection ChurchConnection @relation(fields: [requesterConnectionId], references: [id], onDelete: Restrict)
}

model SupportMessage {
  id String @id @default(cuid())
  caseId String
  authorId String
  kind String
  body String
  version Int
  createdAt DateTime @default(now())
  redactedAt DateTime?
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  author PlatformUser @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([caseId, version])
}

model SupportRead {
  caseId String
  userId String
  version Int
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([caseId, userId])
}

model SupportOperation {
  id String @id @default(cuid())
  actorId String
  requestKey String
  fingerprint String
  caseId String
  version Int
  actor PlatformUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@unique([actorId, requestKey])
}

model SupportAuditEvent {
  id String @id @default(cuid())
  caseId String
  actorId String?
  action String
  targetId String?
  fromState String?
  toState String?
  version Int
  createdAt DateTime @default(now())
  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
}

model ChurchAuditEvent {
  id String @id @default(cuid())
  churchId String?
  actorId String
  targetId String
  action String
  fromState String?
  toState String?
  version Int?
  createdAt DateTime @default(now())
  church Church? @relation(fields: [churchId], references: [id], onDelete: Restrict)
  @@index([churchId, createdAt])
}

enum PostAudience {
  PUBLIC
  CHURCH
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  WITHDRAWN
}

enum PostReplyAudience {
  VIEWERS
  CHURCH_MEMBERS
}

model PlatformPost {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  authorId  String
  authorChurchId String?
  audienceChurchId String?
  audience PostAudience @default(PUBLIC)
  status PostStatus @default(PUBLISHED)
  version Int @default(1)
  requestKey String?
  type      PlatformPostType @default(UPDATE)
  content   String
  scripture String?
  linkUrl String?
  linkTitle String?
  linkDescription String?
  linkSourceUrl String?
  topics String[] @default([])
  editedAt DateTime?
  publishedAt DateTime? @default(now())
  withdrawnAt DateTime?
  discussionClosed Boolean @default(false)
  replyAudience PostReplyAudience @default(VIEWERS)
  allowReposts Boolean @default(false)
  pinUntil DateTime?
  scheduleAt DateTime?
  scheduledById String?
  scheduleLocal String?
  scheduleZone String?
  eventOccurrenceId String? @unique

  author   PlatformUser          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorChurch Church? @relation("ChurchPostAuthor", fields: [authorChurchId], references: [id], onDelete: Restrict)
  audienceChurch Church? @relation("ChurchPostAudience", fields: [audienceChurchId], references: [id], onDelete: Restrict)
  eventOccurrence CalendarOccurrence? @relation(fields: [eventOccurrenceId], references: [id], onDelete: Restrict)
  audit PostAudit[]
  images MediaAsset[]
  photoReferences PostPhotoReference[]
  poll PostPoll?
  volunteerSlots PostVolunteerSlot[]
  likes    PlatformPostLike[]
  comments PlatformPostComment[]
  commentPin CommentPin?
  conversationPreferences ConversationPreference[]
  commentDrafts PrivateCommentDraft[]

  savedItems SavedPostItem[]

  @@unique([authorId, requestKey])
  @@index([authorId])
  @@index([type])
  @@index([createdAt])
  @@index([audienceChurchId, status, publishedAt])
  @@index([status, scheduleAt])
}

model PostAudit {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  postId String
  actorId String
  action String
  targetId String?
  version Int
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  @@index([postId, createdAt])
}

model PostPoll {
  id String @id @default(cuid())
  postId String @unique
  question String
  multiple Boolean @default(false)
  closesAt DateTime @db.Timestamptz(3)
  closesLocal String
  timeZone String
  closedAt DateTime?
  lockedAt DateTime?
  version Int @default(1)
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  options PostPollOption[]
  ballots PostPollBallot[]
}

model PostPollOption {
  id String @id @default(cuid())
  pollId String
  label String
  position Int
  poll PostPoll @relation(fields: [pollId], references: [id], onDelete: Restrict)
  @@unique([pollId, position])
}

model PostPollBallot {
  id String @id @default(cuid())
  pollId String
  userId String
  optionIds String[]
  version Int @default(1)
  updatedAt DateTime @updatedAt
  poll PostPoll @relation(fields: [pollId], references: [id], onDelete: Restrict)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([pollId, userId])
  @@index([userId])
}

model PostVolunteerSlot {
  id String @id @default(cuid())
  postId String
  requestKey String
  role String
  capacity Int
  closedAt DateTime?
  version Int @default(1)
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Restrict)
  signups PostVolunteerSignup[]
  @@unique([postId, requestKey])
}

enum VolunteerSignupState {
  ACTIVE
  CANCELED
}

model PostVolunteerSignup {
  id String @id @default(cuid())
  slotId String
  userId String
  state VolunteerSignupState @default(ACTIVE)
  version Int @default(1)
  eventVersion Int
  occurrenceVersion Int
  updatedAt DateTime @updatedAt
  slot PostVolunteerSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([slotId, userId])
  @@index([userId, state])
}

model PlatformPostLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  postId    String
  userId    String

  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PlatformPostComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  postId    String
  authorId  String
  authorChurchId String?
  authorChurch Church? @relation(fields: [authorChurchId], references: [id], onDelete: Restrict)
  content   String
  parentId String?
  rootId String?
  version Int @default(1)
  editedAt DateTime?
  deletedAt DateTime?
  parent PlatformPostComment? @relation("CommentParent", fields: [parentId, postId], references: [id, postId], onDelete: NoAction, onUpdate: NoAction)
  children PlatformPostComment[] @relation("CommentParent")
  root PlatformPostComment? @relation("CommentRoot", fields: [rootId, postId], references: [id, postId], onDelete: NoAction, onUpdate: NoAction)
  replies PlatformPostComment[] @relation("CommentRoot")
  likes CommentLike[]
  mentions CommentMention[]
  pin CommentPin?

  post   PlatformPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author PlatformUser @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@unique([id, postId])
  @@index([postId, rootId, createdAt, id])
}

model CommentLike {
  id String @id @default(cuid())
  commentId String
  userId String
  active Boolean @default(true)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  comment PlatformPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([commentId, userId])
  @@index([userId])
}

model CommentMention {
  id String @id @default(cuid())
  commentId String
  recipientId String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  comment PlatformPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  recipient PlatformUser @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([commentId, recipientId])
  @@index([recipientId])
}

model CommentPin {
  postId String @id
  commentId String? @unique
  version Int @default(1)
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment PlatformPostComment? @relation(fields: [commentId, postId], references: [id, postId], onDelete: NoAction, onUpdate: NoAction)
  @@unique([commentId, postId])
}

model ConversationPreference {
  id String @id @default(cuid())
  ownerId String
  postId String
  mode String @default("DEFAULT")
  version Int @default(1)
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([ownerId, postId])
}

model PrivateCommentDraft {
  ownerId String
  id String
  postId String
  replyToId String?
  authorChurchId String?
  content String
  mentionIds String[] @default([])
  version Int @default(1)
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post PlatformPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([ownerId, id])
  @@index([ownerId, deletedAt, postId, replyToId])
}

// Canonical event intents, not a notification delivery queue. Never copy text,
// private recipient preferences or credential data into these records.
model SocialEvent {
  id String @id @default(cuid())
  key String @unique
  kind String
  actorId String
  postId String
  commentId String
  recipientId String?
  createdAt DateTime @default(now())
  @@index([postId, createdAt])
  @@index([recipientId, createdAt])
}

model PlatformFollow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  followingId String

  follower  PlatformUser @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following PlatformUser @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

enum ChurchClaimStatus {
  DRAFT
  SUBMITTED
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  WITHDRAWN
  REVOKED
}

model ChurchClaim {
  id                    String                  @id @default(cuid())
  ownerId               String
  requestKey            String
  churchId              String?
  kind                  String
  authority             Json
  profile               Json
  preparation           String                  @default("")
  scopes                ChurchCapability[]      @default([])
  status                ChurchClaimStatus       @default(DRAFT)
  version               Int                     @default(1)
  baseChurchVersion     Int?
  baseManagementVersion Int                     @default(0)
  credentialVersion     Int?
  reviewReason          String                  @default("")
  approvedBy            String?
  policyVersion         String?
  submittedAt           DateTime?
  approvedAt            DateTime?
  activatedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  owner                 PlatformUser            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  church                Church?                 @relation(fields: [churchId], references: [id], onDelete: Restrict)
  decisions             ChurchClaimDecision[]
  grants                ChurchCapabilityGrant[]

  @@unique([ownerId, requestKey])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([churchId])
}

model ChurchClaimDecision {
  id        String      @id @default(cuid())
  claimId   String
  actorId   String
  action    String
  reason    String
  evidence  Json
  version   Int
  createdAt DateTime    @default(now())
  claim     ChurchClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
}

// Each contribution belongs to one appointment, never its reusable title.
model ChurchRoleGrant {
  id String @id @default(cuid())
  assignmentId String
  churchId String
  connectionId String
  capability ChurchCapability
  grantedById String
  version Int @default(1)
  createdAt DateTime @default(now())
  revokedAt DateTime?
  assignment ChurchPositionAssignment @relation(fields: [assignmentId, churchId, connectionId], references: [id, churchId, connectionId], onDelete: Restrict, onUpdate: Restrict)
  grantedBy PlatformUser @relation(fields: [grantedById], references: [id], onDelete: Restrict)
  @@unique([assignmentId, capability])
  @@index([churchId, capability, revokedAt])
}

// A receipt binds retries to the exact reviewed result, not just a reused key.
model ChurchAssignmentSave {
  requestKey String @id
  assignmentId String
  churchId String
  connectionId String
  actorId String
  inputHash String
  resultVersion Int
  createdAt DateTime @default(now())
  assignment ChurchPositionAssignment @relation(fields: [assignmentId, churchId, connectionId], references: [id, churchId, connectionId], onDelete: Restrict, onUpdate: Restrict)
  @@index([assignmentId])
}

// Chart retries and history contain placement/layout only, never assignment data.
model ChurchChartSave {
  requestKey String @id
  churchId String
  actorId String
  inputHash String
  resultVersion Int
  changes Json
  createdAt DateTime @default(now())
  church Church @relation(fields: [churchId], references: [id], onDelete: Restrict)
  actor PlatformUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([churchId, resultVersion])
  @@index([churchId, createdAt])
}

// Author-private unfinished composer input, separate from published post status.
// Tombstones prevent a delayed autosave from recreating discarded/published work.
model PrivatePostDraft {
  publicationKey String @default(cuid())
  id String
  ownerId String
  version Int @default(1)
  payload Json
  publishedPostId String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@id([ownerId, id])
  @@index([ownerId, deletedAt, id])
}

model SavedPostCollection {
  id String
  ownerId String
  name String
  version Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items SavedPostItem[]
  @@id([ownerId, id])
  @@index([ownerId, deletedAt, id])
}

model SavedPostItem {
  id String @id @default(cuid())
  ownerId String
  postId String?
  collectionId String?
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post PlatformPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  collection SavedPostCollection? @relation(fields: [ownerId, collectionId], references: [ownerId, id], onDelete: Restrict)
  @@unique([ownerId, postId])
  @@index([ownerId, collectionId, id])
}

// Receipts contain only IDs/versions, never draft text or source excerpts.
model PostWorkspaceOperation {
  ownerId String
  key String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@id([ownerId, key])
}


model SocialPreferences {
  ownerId String @id
  version Int @default(1)
  mentions String @default("EVERYONE")
  showRelationships Boolean @default(true)
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model SocialRelationship {
  id String @id @default(cuid())
  ownerId String
  targetUserId String?
  churchId String?
  followingChurch Boolean @default(false)
  favorite Boolean @default(false)
  muted Boolean @default(false)
  snoozedUntil DateTime?
  blocked Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  owner PlatformUser @relation("SocialOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser PlatformUser? @relation("SocialTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  church Church? @relation(fields: [churchId], references: [id], onDelete: Cascade)
  @@unique([ownerId, targetUserId])
  @@unique([ownerId, churchId])
  @@index([targetUserId, blocked])
  @@index([ownerId, blocked])
  @@index([ownerId, id])
}

model SocialOperation {
  ownerId String
  key String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@id([ownerId, key])
  @@index([ownerId, createdAt])
}

// Consent records supplement, but never replace, the canonical PlatformFollow graph.
model FriendInvitation {
  ownerId String @id
  token String @unique
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  revokedAt DateTime?
  owner PlatformUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model FriendAcceptance {
  id String @id @default(cuid())
  inviterId String
  recipientId String
  // Unique only for signup-bound consent; ordinary explicit member acceptances use null.
  signupRecipientId String? @unique
  invitationVersion Int
  state String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inviter PlatformUser @relation("FriendInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  recipient PlatformUser @relation("FriendRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([inviterId, recipientId])
  @@index([recipientId, state])
}
