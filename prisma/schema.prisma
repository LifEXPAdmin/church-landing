generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WaitlistRole {
  BELIEVER
  CHURCH
  CREATOR
  BUSINESS
  BUILDER
}

enum AnalyticsEventType {
  PAGE_VIEW
  CTA_CLICK
  JOIN_SUBMIT
  JOIN_SUCCESS
}

model WaitlistSignup {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  role      WaitlistRole
  name      String
  email     String
  message   String?
  source    String?

  @@index([createdAt])
  @@index([role])
  @@index([email])
  @@unique([email, role])
}

model WaitlistEvent {
  id         String             @id @default(cuid())
  createdAt  DateTime           @default(now())
  eventType  AnalyticsEventType
  path       String
  role       WaitlistRole?
  label      String?
  userAgent  String?
  ipHash     String?
  referrer   String?

  @@index([createdAt])
  @@index([eventType])
  @@index([path])
}

enum PlatformRole {
  BELIEVER
  CHURCH
  CREATOR
  BUSINESS
  BUILDER
}

enum PlatformPostType {
  TESTIMONY
  PRAYER
  TEACHING
  UPDATE
  NEED
}

model PlatformUser {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  name      String
  username  String       @unique
  email     String       @unique
  role      PlatformRole @default(BELIEVER)
  bio       String?
  location  String?
  website   String?
  interests String[]     @default([])

  posts     PlatformPost[]
  following PlatformFollow[] @relation("following")
  followers PlatformFollow[] @relation("followers")

  @@index([role])
  @@index([createdAt])
}

model PlatformPost {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  authorId  String
  type      PlatformPostType @default(UPDATE)
  content   String
  scripture String?

  author PlatformUser @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([type])
  @@index([createdAt])
}

model PlatformFollow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  followingId String

  follower  PlatformUser @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following PlatformUser @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}
