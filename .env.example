# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/church"
# Direct PostgreSQL connection (used for Prisma migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/church"

# Basic auth password for /admin/*
ADMIN_PASSWORD="change-me"

# Public site URL for canonical metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Random salt for analytics IP hashing
ANALYTICS_SALT="replace-with-random-string"

# MailerLite API key
MAILERLITE_API_KEY=""

# Optional: group IDs (preferred, fastest)
MAILERLITE_GROUP_ID_BELIEVER=""
MAILERLITE_GROUP_ID_CHURCH=""
MAILERLITE_GROUP_ID_CREATOR=""
MAILERLITE_GROUP_ID_BUSINESS=""
MAILERLITE_GROUP_ID_BUILDER=""

# Optional: group names (fallback if IDs are not set)
MAILERLITE_GROUP_NAME_BELIEVER="Church (User)"
MAILERLITE_GROUP_NAME_CHURCH="Church (Church)"
MAILERLITE_GROUP_NAME_CREATOR="Church (Creator)"
MAILERLITE_GROUP_NAME_BUSINESS="Church (Business)"
MAILERLITE_GROUP_NAME_BUILDER="Church (Builder)"

# New private support intake stays off until an actual recipient and privacy notice are approved.
SUPPORT_INTAKE_ENABLED="false"
# Feedback surfaces and selected updates remain gated until the actual recipient,
# notices, protected recovery and relevant delivery prerequisites are verified.
FEEDBACK_INTAKE_ENABLED="false"
FEEDBACK_IDEAS_ENABLED="false"
FEEDBACK_FOLLOWUP_ENABLED="false"

# Private community reports require explicit reviewer coverage and approved
# operations before activation. This is separate from support and claim intake.
COMMUNITY_REPORTS_ENABLED="false"
COMMUNITY_REPORTS_PER_10_MINUTES="5"

# Approved retention policy: configure protected private Blob storage and verify
# backup expiry/restore and maintenance before enabling permanent closure.
# The existing CRON_SECRET also protects retention/notification maintenance.
ACCOUNT_DELETION_ENABLED="false"
RETENTION_CLEANUP_ENABLED="false"

# Configure the actual verified founder account and normal scoped reviewer grant.
# Do not infer an identity or enable historical welcome backfills.
FOUNDER_ACCOUNT_ID=""
FOUNDER_WELCOME_ENABLED="false"

# Standard Web Push: one securely generated, persistent server-only VAPID pair.
# Configure native queue triggers and verify operations before enabling.
PUSH_ENABLED="false"
PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
PUSH_VAPID_SUBJECT="https://godschurches.com"

# Account links stay disabled until a verified transactional sender is ready.
ACCOUNT_ORIGIN="http://localhost:3000"
# Set a random secret of at least 32 characters for production.
# Local development can omit it to use the local-only fallback.
# AUTH_RATE_LIMIT_SECRET=""
# New committed community activity per account. Exact retries do not consume a
# new slot. Blank/invalid configured values fail closed; omit to use defaults.
# COMMUNITY_POSTS_PER_HOUR="10"
# COMMUNITY_COMMENTS_PER_10_MINUTES="30"
# COMMUNITY_FOLLOWS_PER_HOUR="30"
ACCOUNT_DELIVERY_MODE="disabled"
# Production only: ACCOUNT_DELIVERY_MODE="resend", HTTPS origin, a sending key,
# and a bare sender address on the site domain (or its subdomain).
# See docs/godschurches/ACCOUNT_DELIVERY_REPORT.md before activation.
RESEND_API_KEY=""
ACCOUNT_EMAIL_FROM=""

# Home/My feed use private account choices: Latest, Friends, Top This Week and
# Trending. PLATFORM_HOME_FEED_MODE is retired for these public app routes.

# Representative review stays paused until the verification policy and reviewer
# operations are approved. Draft preparation works with the safe default.
CHURCH_CLAIM_REVIEW_ENABLED=false
CHURCH_CLAIM_POLICY_VERSION=
# Images stay disabled until private storage and cleanup acceptance are complete.
# MEDIA_STORAGE_MODE=private-blob
# Connect a PRIVATE Blob store; credentials are server-only.
# BLOB_STORE_ID= (with Vercel OIDC) or BLOB_READ_WRITE_TOKEN=
# Daily image cleanup uses a separate, random server-only secret (32+ characters).
# Keep maintenance configured when disabling uploads. See MEDIA_MAINTENANCE.md.
# CRON_SECRET=
